# 1) stub package banao jo smoldot ko safely replace karega
mkdir -p tools/empty-pkg

cat > tools/empty-pkg/package.json << 'EOF'
{
  "name": "empty-pkg",
  "version": "0.0.0",
  "description": "No-op stub used to override heavy/unwanted transitive deps (e.g. smoldot) in the workspace lockfile.",
  "main": "index.js",
  "license": "Apache-2.0"
}
EOF

cat > tools/empty-pkg/index.js << 'EOF'
// Intentionally empty. This module exists only so that npm's "overrides"
// field has something real to resolve to.
module.exports = {};
EOF

# 2) root package.json ka broken override fix karo (npm:@aspect-build/empty -> file:./tools/empty-pkg)
node -e "
const fs = require('fs');
const p = JSON.parse(fs.readFileSync('package.json', 'utf8'));
p.overrides = { smoldot: 'file:./tools/empty-pkg' };
p.engines = p.engines || { node: '>=22' };
fs.writeFileSync('package.json', JSON.stringify(p, null, 2) + '\n');
console.log('package.json patched:', JSON.stringify(p.overrides));
"

# 3) purana lockfile hata ke fresh install (purana lockfile abhi bhi broken ref yaad rakhega)
rm -f package-lock.json
npm install

# 4) commit + push
git add tools/empty-pkg package.json package-lock.json
git commit -m "fix: replace broken @aspect-build/empty override with local stub package"
git push
